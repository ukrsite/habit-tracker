{
  "name": "habit-tracker-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx/cjs src/app.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "node --loader tsx/cjs src/db/migrate.ts",
    "db:seed": "node --loader tsx/cjs src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/session": "^10.8.1",
    "@fastify/websocket": "^10.0.1",
    "better-sqlite3": "^11.6.0",
    "connect-sqlite3": "^0.9.13",
    "drizzle-kit": "^0.18.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/connect-sqlite3": "^0.9.6",
    "@types/node": "^20.12.0",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "tar": ">=6.2.0",
    "@tootallnate/once": ">=2.0.1",
    "esbuild": ">=0.24.3"
  }
}
